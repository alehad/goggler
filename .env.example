DATABASE_URL=postgresql://<local-role>@localhost:5432/goggler_prod
NEON_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
TEST_DATABASE_URL=postgresql://<local-role>@localhost:5432/goggler_test
# Which named database target getPrismaClient() connects to: "local" (DATABASE_URL) or
# "neon" (NEON_DATABASE_URL). Defaults to "neon" when unset.
GOGGLER_DB_TARGET=
GOGGLER_AUTH_SECRET=
EBAY_ENVIRONMENT=sandbox

# Sandbox credentials are required when EBAY_ENVIRONMENT=sandbox.
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_REDIRECT_URI=
EBAY_SANDBOX_OAUTH_SCOPES=

# Production credentials are required when EBAY_ENVIRONMENT=production.
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_PRODUCTION_REDIRECT_URI=
EBAY_PRODUCTION_OAUTH_SCOPES=

EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_TRADING_SITE_ID=3
GOGGLER_EBAY_HISTORY_SOURCE=fixture

# Which named tunnel's exact hostname is trusted for the eBay OAuth callback redirect:
# "tailscale" (GOGGLER_TAILSCALE_HOSTNAME) or "ngrok" (GOGGLER_NGROK_HOSTNAME).
# Defaults to "tailscale" when unset. Matched exactly, not by suffix — see
# openspec/changes/tunnel-target-selection/design.md for why.
GOGGLER_TUNNEL_TARGET=
GOGGLER_TAILSCALE_HOSTNAME=
GOGGLER_NGROK_HOSTNAME=
# Comma-separated list of additional exact origins (scheme://host[:port]) to trust for the
# eBay OAuth callback redirect, regardless of GOGGLER_TUNNEL_TARGET.
GOGGLER_ALLOWED_PUBLIC_ORIGINS=

# Anthropic API key powering the Analytics tab's AI chat assistant. Picked up automatically
# by `new Anthropic()` (the SDK's own standard variable name). Set your own monthly spend
# limit in the Anthropic Console (Settings -> Billing -> Spend limits) as a hard cap.
ANTHROPIC_API_KEY=
